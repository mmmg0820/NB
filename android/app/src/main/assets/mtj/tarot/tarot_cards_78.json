[
  {"id":0,"name_en":"The Fool","name_kr":"바보","arcana":"Major Arcana","upright_keywords":["시작","자유","모험"],"reversed_keywords":["무모함","불안정","준비 부족"],"basic_meaning":"새로운 시작과 가능성이 열리는 시기입니다. 두려움보다 호기심을 믿고 움직이면 예상 밖의 기회가 찾아올 수 있습니다."},
  {"id":1,"name_en":"The Magician","name_kr":"마법사","arcana":"Major Arcana","upright_keywords":["의지","창조","실행력"],"reversed_keywords":["속임수","미숙함","집중 부족"],"basic_meaning":"당신에게 필요한 재능과 도구는 이미 갖춰져 있습니다. 생각만 하던 일을 실제 행동으로 옮길 때 좋은 흐름이 생깁니다."},
  {"id":2,"name_en":"The High Priestess","name_kr":"여사제","arcana":"Major Arcana","upright_keywords":["직관","비밀","내면"],"reversed_keywords":["혼란","불신","감정 억압"],"basic_meaning":"겉으로 보이는 정보보다 마음속 직감이 더 중요한 시기입니다. 서두르기보다 조용히 관찰하면 숨은 답을 발견할 수 있습니다."},
  {"id":3,"name_en":"The Empress","name_kr":"여황제","arcana":"Major Arcana","upright_keywords":["풍요","돌봄","매력"],"reversed_keywords":["과잉보호","나태","불균형"],"basic_meaning":"관계와 일상에 따뜻한 성장의 기운이 흐릅니다. 자신을 돌보고 주변과 나누는 태도가 더 큰 풍요를 부릅니다."},
  {"id":4,"name_en":"The Emperor","name_kr":"황제","arcana":"Major Arcana","upright_keywords":["질서","책임","안정"],"reversed_keywords":["고집","통제","권위주의"],"basic_meaning":"흔들리는 상황을 정리하고 기준을 세워야 할 때입니다. 감정보다는 구조와 책임감이 문제를 해결하는 열쇠가 됩니다."},
  {"id":5,"name_en":"The Hierophant","name_kr":"교황","arcana":"Major Arcana","upright_keywords":["전통","조언","배움"],"reversed_keywords":["고정관념","반항","독단"],"basic_meaning":"검증된 방식이나 신뢰할 수 있는 조언이 도움이 됩니다. 혼자 판단하기보다 경험 있는 사람의 지혜를 참고해 보세요."},
  {"id":6,"name_en":"The Lovers","name_kr":"연인","arcana":"Major Arcana","upright_keywords":["사랑","선택","조화"],"reversed_keywords":["갈등","유혹","불일치"],"basic_meaning":"중요한 관계나 선택의 기로에 서 있습니다. 마음이 끌리는 방향과 책임져야 할 현실 사이의 균형이 필요합니다."},
  {"id":7,"name_en":"The Chariot","name_kr":"전차","arcana":"Major Arcana","upright_keywords":["승리","추진력","의지"],"reversed_keywords":["통제 상실","성급함","방향 혼란"],"basic_meaning":"목표를 향해 강하게 밀고 나갈 수 있는 흐름입니다. 다만 속도보다 방향을 분명히 해야 원하는 결과에 가까워집니다."},
  {"id":8,"name_en":"Strength","name_kr":"힘","arcana":"Major Arcana","upright_keywords":["용기","인내","부드러운 통제"],"reversed_keywords":["두려움","충동","자신감 부족"],"basic_meaning":"강하게 밀어붙이기보다 부드럽게 버티는 힘이 필요한 때입니다. 감정을 다스리면 상황은 생각보다 안정적으로 풀립니다."},
  {"id":9,"name_en":"The Hermit","name_kr":"은둔자","arcana":"Major Arcana","upright_keywords":["성찰","지혜","고독"],"reversed_keywords":["고립","회피","방향 상실"],"basic_meaning":"잠시 거리를 두고 자신만의 답을 찾아야 합니다. 외부의 소음보다 내면의 기준을 확인하는 시간이 중요합니다."},
  {"id":10,"name_en":"Wheel of Fortune","name_kr":"운명의 수레바퀴","arcana":"Major Arcana","upright_keywords":["전환","운명","기회"],"reversed_keywords":["정체","불운","저항"],"basic_meaning":"상황이 새로운 국면으로 바뀌고 있습니다. 변화를 억지로 막기보다 흐름을 읽고 유연하게 대응하는 것이 좋습니다."},
  {"id":11,"name_en":"Justice","name_kr":"정의","arcana":"Major Arcana","upright_keywords":["균형","판단","책임"],"reversed_keywords":["불공정","회피","편견"],"basic_meaning":"공정한 판단과 책임 있는 선택이 필요한 시기입니다. 감정에 치우치지 않고 사실을 기준으로 보면 답이 분명해집니다."},
  {"id":12,"name_en":"The Hanged Man","name_kr":"매달린 사람","arcana":"Major Arcana","upright_keywords":["희생","관점 전환","기다림"],"reversed_keywords":["정체","고집","무의미한 희생"],"basic_meaning":"지금은 억지로 움직이기보다 관점을 바꿔야 할 때입니다. 잠시 멈춤이 오히려 더 나은 선택을 준비하게 해줍니다."},
  {"id":13,"name_en":"Death","name_kr":"죽음","arcana":"Major Arcana","upright_keywords":["끝맺음","변화","재탄생"],"reversed_keywords":["미련","저항","지연"],"basic_meaning":"오래된 흐름이 끝나고 새로운 단계가 시작됩니다. 붙잡고 있던 것을 정리하면 더 건강한 변화가 찾아옵니다."},
  {"id":14,"name_en":"Temperance","name_kr":"절제","arcana":"Major Arcana","upright_keywords":["균형","조율","회복"],"reversed_keywords":["과함","불균형","성급함"],"basic_meaning":"서로 다른 요소를 차분히 맞춰야 하는 시기입니다. 급한 결론보다 적절한 조율이 좋은 결과를 만듭니다."},
  {"id":15,"name_en":"The Devil","name_kr":"악마","arcana":"Major Arcana","upright_keywords":["집착","유혹","속박"],"reversed_keywords":["해방","인식","끊어냄"],"basic_meaning":"무언가에 지나치게 묶여 있지는 않은지 돌아봐야 합니다. 욕망을 인정하되 그것이 당신을 지배하지 않게 하는 것이 중요합니다."},
  {"id":16,"name_en":"The Tower","name_kr":"탑","arcana":"Major Arcana","upright_keywords":["충격","붕괴","각성"],"reversed_keywords":["불안","회피","늦은 변화"],"basic_meaning":"예상치 못한 변화가 기존의 틀을 흔들 수 있습니다. 불편하더라도 진실을 마주하면 더 단단한 기반을 다시 세울 수 있습니다."},
  {"id":17,"name_en":"The Star","name_kr":"별","arcana":"Major Arcana","upright_keywords":["희망","치유","영감"],"reversed_keywords":["실망","불신","무기력"],"basic_meaning":"어두운 시간을 지나 회복과 희망의 기운이 들어옵니다. 작지만 진심 어린 믿음이 앞으로 나아갈 힘이 됩니다."},
  {"id":18,"name_en":"The Moon","name_kr":"달","arcana":"Major Arcana","upright_keywords":["불안","환상","무의식"],"reversed_keywords":["진실 발견","혼란 해소","직면"],"basic_meaning":"상황이 명확하지 않아 불안이 커질 수 있습니다. 확실하지 않은 정보에 휘둘리기보다 시간을 두고 진실을 확인하세요."},
  {"id":19,"name_en":"The Sun","name_kr":"태양","arcana":"Major Arcana","upright_keywords":["성공","기쁨","활력"],"reversed_keywords":["지연","자만","불완전한 만족"],"basic_meaning":"밝고 긍정적인 결과가 기대되는 카드입니다. 자신감을 가지고 표현하면 주변의 인정과 좋은 성과가 따를 수 있습니다."},
  {"id":20,"name_en":"Judgement","name_kr":"심판","arcana":"Major Arcana","upright_keywords":["각성","결단","부활"],"reversed_keywords":["후회","망설임","자기비판"],"basic_meaning":"과거를 돌아보고 중요한 결정을 내려야 할 때입니다. 스스로를 탓하기보다 배운 것을 바탕으로 새롭게 출발하세요."},
  {"id":21,"name_en":"The World","name_kr":"세계","arcana":"Major Arcana","upright_keywords":["완성","성취","통합"],"reversed_keywords":["미완성","지연","허전함"],"basic_meaning":"하나의 여정이 완성에 가까워지고 있습니다. 지금까지의 노력이 결실을 맺으며 다음 단계로 넘어갈 준비가 됩니다."},
  {"id":22,"name_en":"Ace of Wands","name_kr":"완드 에이스","arcana":"Minor Arcana","upright_keywords":["창의력","시작","열정"],"reversed_keywords":["지연","의욕 저하","불씨 약화"],"basic_meaning":"새로운 의지와 창의적인 불씨가 막 피어나는 카드입니다. 지금 떠오른 아이디어를 작게라도 행동으로 옮기면 흐름이 살아납니다."},
  {"id":23,"name_en":"Two of Wands","name_kr":"완드 2","arcana":"Minor Arcana","upright_keywords":["계획","시야 확장","선택"],"reversed_keywords":["망설임","좁은 시야","준비 부족"],"basic_meaning":"더 넓은 가능성을 바라보며 방향을 정해야 하는 시기입니다. 성급히 움직이기보다 선택지의 거리와 비용을 가늠해 보세요."},
  {"id":24,"name_en":"Three of Wands","name_kr":"완드 3","arcana":"Minor Arcana","upright_keywords":["확장","기다림","전망"],"reversed_keywords":["지연","예상 착오","협력 부족"],"basic_meaning":"이미 시작한 일이 바깥으로 확장될 수 있는 흐름입니다. 결과를 기다리되 다음 연결과 협력의 문을 함께 열어두는 것이 좋습니다."},
  {"id":25,"name_en":"Four of Wands","name_kr":"완드 4","arcana":"Minor Arcana","upright_keywords":["축하","안정","공동체"],"reversed_keywords":["불안정","갈등","기쁨 지연"],"basic_meaning":"작은 성취를 함께 나누고 기반을 다질 수 있는 카드입니다. 관계와 공간의 안정감이 다음 도약을 지탱해 줍니다."},
  {"id":26,"name_en":"Five of Wands","name_kr":"완드 5","arcana":"Minor Arcana","upright_keywords":["경쟁","마찰","훈련"],"reversed_keywords":["소모전","회피","방향 없는 갈등"],"basic_meaning":"여러 에너지가 부딪히며 긴장이 생길 수 있습니다. 이 충돌을 싸움으로 키우기보다 기준을 맞추는 훈련으로 삼아야 합니다."},
  {"id":27,"name_en":"Six of Wands","name_kr":"완드 6","arcana":"Minor Arcana","upright_keywords":["승리","인정","전진"],"reversed_keywords":["자만","인정 부족","불안한 성과"],"basic_meaning":"노력이 드러나고 주변의 인정을 받을 수 있는 카드입니다. 성과를 받아들이되 다음 책임까지 생각하면 흐름이 오래갑니다."},
  {"id":28,"name_en":"Seven of Wands","name_kr":"완드 7","arcana":"Minor Arcana","upright_keywords":["방어","용기","입장 고수"],"reversed_keywords":["압박","포기","소진"],"basic_meaning":"자신의 자리와 기준을 지켜야 하는 순간입니다. 모두를 설득하려 애쓰기보다 핵심 입장을 분명히 하는 것이 중요합니다."},
  {"id":29,"name_en":"Eight of Wands","name_kr":"완드 8","arcana":"Minor Arcana","upright_keywords":["속도","소식","진행"],"reversed_keywords":["지체","혼선","성급함"],"basic_meaning":"상황이 빠르게 움직이고 소식이 오갈 수 있습니다. 속도를 살리되 확인 없이 밀어붙이면 작은 오해가 커질 수 있습니다."},
  {"id":30,"name_en":"Nine of Wands","name_kr":"완드 9","arcana":"Minor Arcana","upright_keywords":["버팀","경계","마지막 힘"],"reversed_keywords":["피로","방어 과잉","불신"],"basic_meaning":"끝까지 버텨온 힘이 있지만 긴장도 큰 카드입니다. 쉬어갈 틈을 만들면서도 마지막 선을 쉽게 무너뜨리지 마세요."},
  {"id":31,"name_en":"Ten of Wands","name_kr":"완드 10","arcana":"Minor Arcana","upright_keywords":["부담","책임","완주"],"reversed_keywords":["과부하","위임 실패","무리"],"basic_meaning":"많은 일을 혼자 짊어진 상태일 수 있습니다. 완주가 가까워도 짐을 나누거나 우선순위를 줄이는 판단이 필요합니다."},
  {"id":32,"name_en":"Page of Wands","name_kr":"완드 페이지","arcana":"Minor Arcana","upright_keywords":["호기심","도전","새 소식"],"reversed_keywords":["산만함","미성숙","계획 부족"],"basic_meaning":"새로운 도전에 대한 호기심과 설렘이 살아나는 카드입니다. 완벽함보다 배우며 움직이는 태도가 더 큰 가능성을 엽니다."},
  {"id":33,"name_en":"Knight of Wands","name_kr":"완드 기사","arcana":"Minor Arcana","upright_keywords":["돌파","열정","이동"],"reversed_keywords":["충동","성급함","불안정"],"basic_meaning":"강한 추진력으로 상황을 돌파하려는 에너지가 큽니다. 다만 속도가 방향을 대신할 수 없으니 목표를 선명히 해야 합니다."},
  {"id":34,"name_en":"Queen of Wands","name_kr":"완드 여왕","arcana":"Minor Arcana","upright_keywords":["자신감","매력","주도성"],"reversed_keywords":["질투","자신감 흔들림","과한 통제"],"basic_meaning":"자신의 빛을 숨기지 않고 자연스럽게 영향력을 발휘하는 카드입니다. 따뜻한 카리스마가 주변의 참여를 이끌 수 있습니다."},
  {"id":35,"name_en":"King of Wands","name_kr":"완드 왕","arcana":"Minor Arcana","upright_keywords":["비전","리더십","결단"],"reversed_keywords":["독단","성급한 지시","권위 과잉"],"basic_meaning":"큰 그림을 보고 사람들을 이끌어야 하는 카드입니다. 강한 비전은 좋지만 실행 가능한 약속으로 내려와야 힘을 얻습니다."},
  {"id":36,"name_en":"Ace of Cups","name_kr":"컵 에이스","arcana":"Minor Arcana","upright_keywords":["새 감정","사랑","치유"],"reversed_keywords":["감정 억제","허전함","닫힌 마음"],"basic_meaning":"마음이 새롭게 열리고 감정의 물길이 시작되는 카드입니다. 솔직한 감정을 인정할 때 관계와 회복의 가능성이 커집니다."},
  {"id":37,"name_en":"Two of Cups","name_kr":"컵 2","arcana":"Minor Arcana","upright_keywords":["교감","화해","파트너십"],"reversed_keywords":["불균형","오해","거리감"],"basic_meaning":"서로의 마음이 마주 보고 균형을 찾는 카드입니다. 관계에서는 진심 어린 대화와 동등한 존중이 핵심입니다."},
  {"id":38,"name_en":"Three of Cups","name_kr":"컵 3","arcana":"Minor Arcana","upright_keywords":["우정","축하","연대"],"reversed_keywords":["소외","과한 분위기","관계 피로"],"basic_meaning":"사람들과 기쁨을 나누고 지지를 받을 수 있는 카드입니다. 다만 분위기에 휩쓸려 본심을 잃지 않도록 균형을 잡으세요."},
  {"id":39,"name_en":"Four of Cups","name_kr":"컵 4","arcana":"Minor Arcana","upright_keywords":["권태","재평가","내향"],"reversed_keywords":["마음 열림","새 관심","정체 해소"],"basic_meaning":"이미 가진 것에도 마음이 움직이지 않을 수 있습니다. 억지로 반응하기보다 무엇이 비어 있는지 조용히 살펴보세요."},
  {"id":40,"name_en":"Five of Cups","name_kr":"컵 5","arcana":"Minor Arcana","upright_keywords":["상실","후회","슬픔"],"reversed_keywords":["회복","수용","새 가능성"],"basic_meaning":"잃은 것에 마음이 오래 머무는 카드입니다. 슬픔을 부정하지 않되 아직 남아 있는 관계와 기회를 함께 보아야 합니다."},
  {"id":41,"name_en":"Six of Cups","name_kr":"컵 6","arcana":"Minor Arcana","upright_keywords":["추억","순수함","재회"],"reversed_keywords":["과거 집착","미성숙","현실 회피"],"basic_meaning":"과거의 기억이나 익숙한 감정이 현재를 부드럽게 건드립니다. 따뜻함은 힘이 되지만 과거가 현재의 선택을 대신하게 두지는 마세요."},
  {"id":42,"name_en":"Seven of Cups","name_kr":"컵 7","arcana":"Minor Arcana","upright_keywords":["상상","선택지","환상"],"reversed_keywords":["현실 확인","우유부단","착각"],"basic_meaning":"가능성이 많아 보이지만 모두가 현실적인 길은 아닙니다. 끌림과 환상을 구분하고 하나씩 검증하는 태도가 필요합니다."},
  {"id":43,"name_en":"Eight of Cups","name_kr":"컵 8","arcana":"Minor Arcana","upright_keywords":["떠남","탐색","정리"],"reversed_keywords":["미련","회피","결단 지연"],"basic_meaning":"마음이 더 이상 머물 수 없는 곳을 떠나려는 카드입니다. 익숙함을 놓는 일이 두려워도 더 깊은 만족을 찾아야 할 때입니다."},
  {"id":44,"name_en":"Nine of Cups","name_kr":"컵 9","arcana":"Minor Arcana","upright_keywords":["만족","소원","즐거움"],"reversed_keywords":["공허함","과욕","겉치레 만족"],"basic_meaning":"개인적인 만족과 바람의 성취가 가까운 카드입니다. 기쁨을 누리되 그것이 오래갈 수 있는 건강한 욕구인지도 살펴보세요."},
  {"id":45,"name_en":"Ten of Cups","name_kr":"컵 10","arcana":"Minor Arcana","upright_keywords":["행복","가족","정서적 완성"],"reversed_keywords":["불화","이상과 현실 차이","기대 과잉"],"basic_meaning":"관계 안에서 깊은 안정과 기쁨을 느낄 수 있는 카드입니다. 이상적인 모습보다 실제로 함께 돌보는 방식이 중요합니다."},
  {"id":46,"name_en":"Page of Cups","name_kr":"컵 페이지","arcana":"Minor Arcana","upright_keywords":["감성","메시지","상상력"],"reversed_keywords":["감정 기복","미숙함","상처받기 쉬움"],"basic_meaning":"부드러운 감정 표현이나 뜻밖의 메시지가 들어올 수 있습니다. 서툴러도 진심을 다루는 방식에서 새로운 문이 열립니다."},
  {"id":47,"name_en":"Knight of Cups","name_kr":"컵 기사","arcana":"Minor Arcana","upright_keywords":["제안","로맨스","이상"],"reversed_keywords":["감정 과장","현실 부족","변덕"],"basic_meaning":"마음을 담은 제안이나 이상을 향한 움직임이 보입니다. 아름다운 말이 실제 행동으로 이어지는지 확인하는 것이 좋습니다."},
  {"id":48,"name_en":"Queen of Cups","name_kr":"컵 여왕","arcana":"Minor Arcana","upright_keywords":["공감","직관","돌봄"],"reversed_keywords":["감정 과잉","의존","경계 부족"],"basic_meaning":"깊은 공감과 섬세한 직관이 강해지는 카드입니다. 타인의 마음을 돌보되 자신의 경계도 함께 지켜야 합니다."},
  {"id":49,"name_en":"King of Cups","name_kr":"컵 왕","arcana":"Minor Arcana","upright_keywords":["감정 성숙","안정","조율"],"reversed_keywords":["감정 억압","조종","불안정"],"basic_meaning":"감정을 억누르지 않으면서도 차분히 다스리는 힘이 필요합니다. 성숙한 태도가 관계의 파도를 안정시킵니다."},
  {"id":50,"name_en":"Ace of Swords","name_kr":"소드 에이스","arcana":"Minor Arcana","upright_keywords":["명료함","진실","결단"],"reversed_keywords":["혼란","말실수","판단 흐림"],"basic_meaning":"복잡한 상황을 가르는 선명한 생각과 진실의 카드입니다. 감정에 묻힌 핵심을 말로 정리하면 방향이 뚜렷해집니다."},
  {"id":51,"name_en":"Two of Swords","name_kr":"소드 2","arcana":"Minor Arcana","upright_keywords":["보류","균형","어려운 선택"],"reversed_keywords":["회피","결정 압박","정보 부족"],"basic_meaning":"두 선택 사이에서 마음과 생각이 멈춰 있는 카드입니다. 외면한 정보를 확인해야 균형 잡힌 결정을 내릴 수 있습니다."},
  {"id":52,"name_en":"Three of Swords","name_kr":"소드 3","arcana":"Minor Arcana","upright_keywords":["상처","진실","분리"],"reversed_keywords":["회복","용서","상처 반복"],"basic_meaning":"아픈 사실이나 실망이 드러날 수 있는 카드입니다. 고통을 정확히 바라볼 때 회복의 첫 단계가 시작됩니다."},
  {"id":53,"name_en":"Four of Swords","name_kr":"소드 4","arcana":"Minor Arcana","upright_keywords":["휴식","회복","멈춤"],"reversed_keywords":["번아웃","재개","불안한 휴식"],"basic_meaning":"생각과 몸을 잠시 쉬게 해야 하는 카드입니다. 지금의 멈춤은 포기가 아니라 더 나은 판단을 위한 회복입니다."},
  {"id":54,"name_en":"Five of Swords","name_kr":"소드 5","arcana":"Minor Arcana","upright_keywords":["갈등","승패","긴장"],"reversed_keywords":["화해 필요","후회","소모전"],"basic_meaning":"말과 논리의 싸움에서 이겨도 관계가 상할 수 있습니다. 진짜 목표가 승리인지 해결인지 먼저 구분해야 합니다."},
  {"id":55,"name_en":"Six of Swords","name_kr":"소드 6","arcana":"Minor Arcana","upright_keywords":["이동","전환","회복 과정"],"reversed_keywords":["미련","지연","과거 회귀"],"basic_meaning":"어려운 국면에서 조금씩 벗어나는 카드입니다. 완전한 해결은 아니어도 더 나은 곳으로 이동하려는 선택이 필요합니다."},
  {"id":56,"name_en":"Seven of Swords","name_kr":"소드 7","arcana":"Minor Arcana","upright_keywords":["전략","은밀함","회피"],"reversed_keywords":["발각","양심","정직 필요"],"basic_meaning":"정면 돌파보다 전략이 필요한 상황일 수 있습니다. 다만 숨기는 것이 문제를 키우는 방식은 아닌지 점검해야 합니다."},
  {"id":57,"name_en":"Eight of Swords","name_kr":"소드 8","arcana":"Minor Arcana","upright_keywords":["제한","두려움","갇힘"],"reversed_keywords":["해방","새 관점","자기 제한 해소"],"basic_meaning":"상황보다 생각이 자신을 묶고 있을 수 있는 카드입니다. 작게라도 움직일 수 있는 선택지를 찾으면 길이 보입니다."},
  {"id":58,"name_en":"Nine of Swords","name_kr":"소드 9","arcana":"Minor Arcana","upright_keywords":["불안","후회","걱정"],"reversed_keywords":["안도","도움 요청","생각 정리"],"basic_meaning":"걱정이 밤처럼 커지고 마음을 압박할 수 있습니다. 혼자 되뇌기보다 사실과 감정을 분리해 도움을 구하는 것이 좋습니다."},
  {"id":59,"name_en":"Ten of Swords","name_kr":"소드 10","arcana":"Minor Arcana","upright_keywords":["끝","한계","바닥"],"reversed_keywords":["회복 시작","미련","재기"],"basic_meaning":"더 이상 같은 방식으로는 버티기 어려운 끝맺음의 카드입니다. 바닥을 인정하면 다음 회복의 방향도 분명해집니다."},
  {"id":60,"name_en":"Page of Swords","name_kr":"소드 페이지","arcana":"Minor Arcana","upright_keywords":["관찰","호기심","정보"],"reversed_keywords":["성급한 말","오해","산만함"],"basic_meaning":"새로운 정보를 민감하게 포착하는 카드입니다. 질문은 좋지만 확인되지 않은 말을 빠르게 퍼뜨리지 않도록 주의하세요."},
  {"id":61,"name_en":"Knight of Swords","name_kr":"소드 기사","arcana":"Minor Arcana","upright_keywords":["돌진","논쟁","결단"],"reversed_keywords":["무모함","공격성","시야 협소"],"basic_meaning":"생각이 빠르게 움직이고 곧장 밀고 들어가는 에너지입니다. 속도와 날카로움이 장점이지만 상대와 맥락을 놓치면 충돌이 커집니다."},
  {"id":62,"name_en":"Queen of Swords","name_kr":"소드 여왕","arcana":"Minor Arcana","upright_keywords":["통찰","독립","명확한 경계"],"reversed_keywords":["냉정함","비판 과잉","상처의 말"],"basic_meaning":"감정에 휩쓸리지 않고 핵심을 보는 판단력이 강해집니다. 명확한 경계는 필요하지만 말의 온도도 함께 조절하세요."},
  {"id":63,"name_en":"King of Swords","name_kr":"소드 왕","arcana":"Minor Arcana","upright_keywords":["논리","권위","공정함"],"reversed_keywords":["독단","냉혹함","권력 남용"],"basic_meaning":"원칙과 논리로 상황을 정리해야 하는 카드입니다. 권위 있는 판단일수록 공정함과 책임을 함께 가져야 합니다."},
  {"id":64,"name_en":"Ace of Pentacles","name_kr":"펜타클 에이스","arcana":"Minor Arcana","upright_keywords":["기회","현실화","씨앗"],"reversed_keywords":["기회 지연","낭비","불안정"],"basic_meaning":"돈, 일, 건강처럼 현실적인 영역에서 새 기회가 열리는 카드입니다. 작은 씨앗을 꾸준히 돌보면 실제 결실로 이어질 수 있습니다."},
  {"id":65,"name_en":"Two of Pentacles","name_kr":"펜타클 2","arcana":"Minor Arcana","upright_keywords":["균형","조율","유연성"],"reversed_keywords":["과부하","우선순위 혼란","불안정"],"basic_meaning":"여러 현실 문제를 동시에 조율해야 하는 카드입니다. 유연함은 장점이지만 기준 없이 버티면 쉽게 흔들릴 수 있습니다."},
  {"id":66,"name_en":"Three of Pentacles","name_kr":"펜타클 3","arcana":"Minor Arcana","upright_keywords":["협업","기술","인정"],"reversed_keywords":["불협화음","실력 부족","소통 문제"],"basic_meaning":"실력과 협력이 함께 쌓이며 성과가 만들어지는 카드입니다. 혼자 완성하려 하기보다 역할을 맞추면 결과가 좋아집니다."},
  {"id":67,"name_en":"Four of Pentacles","name_kr":"펜타클 4","arcana":"Minor Arcana","upright_keywords":["보유","안정","통제"],"reversed_keywords":["집착","인색함","놓아야 함"],"basic_meaning":"가진 것을 지키려는 마음이 강한 카드입니다. 안정은 필요하지만 너무 움켜쥐면 성장할 공간이 줄어듭니다."},
  {"id":68,"name_en":"Five of Pentacles","name_kr":"펜타클 5","arcana":"Minor Arcana","upright_keywords":["결핍","어려움","고립"],"reversed_keywords":["도움","회복","문 열림"],"basic_meaning":"현실적 부족함이나 소외감이 크게 느껴질 수 있습니다. 도움을 받을 수 있는 문이 없는지 주변을 다시 살펴보세요."},
  {"id":69,"name_en":"Six of Pentacles","name_kr":"펜타클 6","arcana":"Minor Arcana","upright_keywords":["나눔","지원","균형"],"reversed_keywords":["불공정","의존","조건부 도움"],"basic_meaning":"주고받는 균형과 지원의 흐름이 중요한 카드입니다. 도움을 주거나 받을 때 관계의 힘의 균형도 함께 보아야 합니다."},
  {"id":70,"name_en":"Seven of Pentacles","name_kr":"펜타클 7","arcana":"Minor Arcana","upright_keywords":["기다림","평가","인내"],"reversed_keywords":["조급함","성과 부족","방향 재검토"],"basic_meaning":"지금까지 투자한 시간과 노력을 평가하는 카드입니다. 성급히 포기하기보다 무엇을 계속 키울지 차분히 점검하세요."},
  {"id":71,"name_en":"Eight of Pentacles","name_kr":"펜타클 8","arcana":"Minor Arcana","upright_keywords":["숙련","반복","노력"],"reversed_keywords":["태만","완벽주의","기술 부족"],"basic_meaning":"기술과 습관을 반복해서 다듬는 카드입니다. 화려한 변화보다 매일의 집중이 실질적인 성장을 만듭니다."},
  {"id":72,"name_en":"Nine of Pentacles","name_kr":"펜타클 9","arcana":"Minor Arcana","upright_keywords":["독립","여유","성취"],"reversed_keywords":["불안한 자립","과소비","외로움"],"basic_meaning":"스스로 일군 안정과 여유를 누릴 수 있는 카드입니다. 독립의 기쁨을 지키려면 자원 관리도 함께 세심해야 합니다."},
  {"id":73,"name_en":"Ten of Pentacles","name_kr":"펜타클 10","arcana":"Minor Arcana","upright_keywords":["가문","유산","장기 안정"],"reversed_keywords":["가족 갈등","불안정한 기반","단기 사고"],"basic_meaning":"장기적인 안정, 가족, 공동체의 자산을 뜻하는 카드입니다. 지금의 선택이 오래 남을 구조를 만드는지 살펴보세요."},
  {"id":74,"name_en":"Page of Pentacles","name_kr":"펜타클 페이지","arcana":"Minor Arcana","upright_keywords":["배움","실습","현실적 목표"],"reversed_keywords":["산만함","게으름","계획 미흡"],"basic_meaning":"새로운 기술이나 현실적 목표를 배우기 좋은 카드입니다. 작은 실습과 기록이 가능성을 실제 능력으로 바꿉니다."},
  {"id":75,"name_en":"Knight of Pentacles","name_kr":"펜타클 기사","arcana":"Minor Arcana","upright_keywords":["성실","꾸준함","책임"],"reversed_keywords":["정체","완고함","느림"],"basic_meaning":"느리지만 믿을 수 있는 방식으로 앞으로 나아가는 카드입니다. 지루해 보여도 꾸준함이 가장 강한 전략이 될 수 있습니다."},
  {"id":76,"name_en":"Queen of Pentacles","name_kr":"펜타클 여왕","arcana":"Minor Arcana","upright_keywords":["돌봄","풍요","현실 감각"],"reversed_keywords":["과한 희생","불안정한 관리","소진"],"basic_meaning":"생활과 자원을 따뜻하게 돌보는 힘이 커지는 카드입니다. 타인을 챙기면서도 자신의 몸과 시간을 함께 보호하세요."},
  {"id":77,"name_en":"King of Pentacles","name_kr":"펜타클 왕","arcana":"Minor Arcana","upright_keywords":["성공","안정","관리 능력"],"reversed_keywords":["탐욕","고집","물질 집착"],"basic_meaning":"현실적 성과와 안정적인 관리 능력을 보여주는 카드입니다. 풍요를 오래 유지하려면 소유보다 책임 있는 운영이 중요합니다."}
]
